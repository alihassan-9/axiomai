# Copy to .env for local development. NEVER commit a real .env (it is git-ignored).
ENVIRONMENT=development

# === Database ====================================================================
# Option A — local Docker Postgres (docker compose up postgres -d):
DATABASE_URL=postgresql+asyncpg://auditor:auditor@localhost:5432/auditor
DATABASE_SYNC_URL=postgresql+psycopg2://auditor:auditor@localhost:5432/auditor
#
# Option B — Supabase (cloud). Use the SESSION POOLER host (IPv4); URL-encode any
# '@' in the password as %40; keep the +asyncpg driver and ?ssl=require:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-1-<region>.pooler.supabase.com:5432/postgres?ssl=require
# DATABASE_SYNC_URL=postgresql+psycopg2://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# === Auth ========================================================================
# Generate a real secret for anything beyond local dev:  openssl rand -hex 32
JWT_SECRET_KEY=dev-only-change-me
# Supabase is used ONLY to verify Google OAuth sessions (the app issues its own JWTs).
# Leave blank to disable Google sign-in. Publishable key is public by design.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>

# === Redis =======================================================================
# memory:// = in-process fakeredis (no server needed; requires INLINE_AUDIT_EXECUTION=true).
# For a real Redis use redis://localhost:6379/0 (docker compose up redis -d).
REDIS_URL=memory://
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Run audits synchronously without a Celery worker (dev/demo, and required with memory://).
INLINE_AUDIT_EXECUTION=true

# === Object storage ==============================================================
# local = filesystem (no server needed); minio = MinIO/S3.
STORAGE_BACKEND=local
STORAGE_DIR=./storage/files
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=auditor-documents

# === AI stack (local Ollama) =====================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=bge-m3
LLM_ENABLED=true

# === Misc ========================================================================
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=100
MAX_UPLOAD_MB=25
VECTOR_STORE_DIR=./storage/vector_store
