# Copy to .env for local development outside Docker.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://auditor:auditor@localhost:5432/auditor
DATABASE_SYNC_URL=postgresql+psycopg2://auditor:auditor@localhost:5432/auditor
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Generate a real secret for anything beyond local dev:  openssl rand -hex 32
JWT_SECRET_KEY=dev-only-change-me

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=auditor-documents

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=bge-m3
LLM_ENABLED=true

# Set true to run audits synchronously without a Celery worker (dev/demo only).
INLINE_AUDIT_EXECUTION=false

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=100
MAX_UPLOAD_MB=25
VECTOR_STORE_DIR=./storage/vector_store
